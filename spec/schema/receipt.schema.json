{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aeilus.institute/schema/vledger/1/receipt.schema.json",
  "title": "aevri.vledger 1.0 signed exchange receipt",
  "type": "object",
  "required": ["receipt", "signatures"],
  "properties": {
    "receipt": { "$ref": "#/$defs/receipt" },
    "signatures": { "type": "array", "items": { "allOf": [ { "$ref": "common.schema.json#/$defs/signature" } ], "required": ["party"] } }
  },
  "$defs": {
    "receipt": {
      "type": "object",
      "required": ["type", "version", "receiptId", "occurredAt", "parties", "elements", "mandate"],
      "properties": {
        "type": { "const": "aevri.vledger.receipt" },
        "version": { "const": 1 },
        "receiptId": { "$ref": "common.schema.json#/$defs/uuid" },
        "occurredAt": { "$ref": "common.schema.json#/$defs/time" },
        "parties": { "type": "array", "minItems": 2, "items": { "type": "object", "required": ["role", "key"],
          "properties": { "role": { "enum": ["giver", "receiver", "party"] }, "key": { "$ref": "common.schema.json#/$defs/publicKey" }, "label": { "$ref": "common.schema.json#/$defs/line" } } } },
        "elements": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["from", "to", "digest"],
          "properties": { "from": { "type": "integer", "minimum": 0 }, "to": { "type": "integer", "minimum": 0 }, "digest": { "$ref": "common.schema.json#/$defs/sha256" }, "type": { "type": "string", "maxLength": 40 }, "label": { "$ref": "common.schema.json#/$defs/line" } } } },
        "plan": { "type": "array", "items": { "type": "object", "required": ["element", "digest"], "properties": { "element": { "type": "integer", "minimum": 0 }, "digest": { "$ref": "common.schema.json#/$defs/sha256" } } } },
        "arbiters": { "type": "array", "items": { "allOf": [ { "$ref": "common.schema.json#/$defs/arbiterRef" } ], "required": ["party"], "properties": { "party": { "type": "integer", "minimum": 0 } } } },
        "mandate": {
          "type": "object", "required": ["mode"],
          "properties": {
            "mode": { "enum": ["attest", "opinion", "binding"] },
            "arbiter": { "$ref": "common.schema.json#/$defs/arbiterRef" },
            "scope": { "$ref": "common.schema.json#/$defs/text" },
            "rulesUrl": { "type": "string", "pattern": "^https://" }
          },
          "if": { "properties": { "mode": { "const": "binding" } } }, "then": { "required": ["arbiter"] }
        }
      }
    }
  }
}
