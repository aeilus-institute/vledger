{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aeilus.institute/schema/vledger/1/payload.schema.json",
  "title": "aevri.vledger 1.0-d2 record payload (decrypted)",
  "type": "object",
  "required": [
    "kind",
    "createdAt",
    "source",
    "body"
  ],
  "properties": {
    "kind": {
      "enum": [
        "contact",
        "value-system",
        "goal",
        "event",
        "element-type",
        "plan",
        "assessment",
        "fact",
        "settings",
        "message-in",
        "message-out",
        "grant",
        "revocation",
        "disclosure",
        "import",
        "note",
        "stream"
      ]
    },
    "createdAt": {
      "$ref": "common.schema.json#/$defs/time"
    },
    "supersedes": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "source": {
      "enum": [
        "manual",
        "import-file",
        "contact",
        "registry",
        "message",
        "device",
        "agent",
        "vet",
        "vss",
        "aevri.site",
        "aevri.vvp",
        "stream"
      ]
    },
    "retainUntil": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/date"
        },
        {
          "type": "null"
        }
      ]
    },
    "body": {
      "type": "object"
    }
  },
  "if": {
    "properties": {
      "body": {
        "required": [
          "withdrawn"
        ]
      }
    }
  },
  "then": {
    "required": [
      "supersedes"
    ],
    "properties": {
      "body": {
        "properties": {
          "withdrawn": {
            "const": true
          }
        }
      }
    }
  },
  "else": {
    "allOf": [
      {
        "if": {
          "properties": {
            "kind": {
              "const": "contact"
            }
          }
        },
        "then": {
          "properties": {
            "body": {
              "$ref": "#/$defs/contact"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "kind": {
              "const": "value-system"
            }
          }
        },
        "then": {
          "properties": {
            "body": {
              "$ref": "#/$defs/valueSystem"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "kind": {
              "const": "goal"
            }
          }
        },
        "then": {
          "properties": {
            "body": {
              "$ref": "#/$defs/goal"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "kind": {
              "const": "event"
            }
          }
        },
        "then": {
          "properties": {
            "body": {
              "$ref": "#/$defs/event"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "kind": {
              "const": "element-type"
            }
          }
        },
        "then": {
          "properties": {
            "body": {
              "$ref": "#/$defs/elementType"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "kind": {
              "const": "plan"
            }
          }
        },
        "then": {
          "properties": {
            "body": {
              "$ref": "#/$defs/plan"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "kind": {
              "const": "assessment"
            }
          }
        },
        "then": {
          "properties": {
            "body": {
              "$ref": "#/$defs/assessment"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "kind": {
              "const": "fact"
            }
          }
        },
        "then": {
          "properties": {
            "body": {
              "$ref": "#/$defs/fact"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "kind": {
              "const": "settings"
            }
          }
        },
        "then": {
          "properties": {
            "body": {
              "$ref": "#/$defs/settings"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "kind": {
              "const": "message-in"
            }
          }
        },
        "then": {
          "properties": {
            "body": {
              "$ref": "#/$defs/messageIn"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "kind": {
              "const": "message-out"
            }
          }
        },
        "then": {
          "properties": {
            "body": {
              "$ref": "#/$defs/messageOut"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "kind": {
              "const": "grant"
            }
          }
        },
        "then": {
          "properties": {
            "body": {
              "$ref": "#/$defs/grant"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "kind": {
              "const": "revocation"
            }
          }
        },
        "then": {
          "properties": {
            "body": {
              "$ref": "#/$defs/revocation"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "kind": {
              "const": "disclosure"
            }
          }
        },
        "then": {
          "properties": {
            "body": {
              "$ref": "#/$defs/disclosure"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "kind": {
              "const": "import"
            }
          }
        },
        "then": {
          "properties": {
            "body": {
              "$ref": "#/$defs/import"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "kind": {
              "const": "note"
            }
          }
        },
        "then": {
          "properties": {
            "body": {
              "$ref": "#/$defs/note"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "kind": {
              "const": "stream"
            }
          }
        },
        "then": {
          "properties": {
            "body": {
              "$ref": "#/$defs/stream"
            }
          }
        }
      }
    ]
  },
  "$defs": {
    "contact": {
      "type": "object",
      "required": [
        "type",
        "name"
      ],
      "properties": {
        "type": {
          "enum": [
            "self",
            "person",
            "organization",
            "state",
            "group",
            "device",
            "unknown"
          ]
        },
        "name": {
          "$ref": "common.schema.json#/$defs/line"
        },
        "address": {
          "$ref": "common.schema.json#/$defs/address"
        },
        "card": {
          "$ref": "card.schema.json"
        },
        "note": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/uuid"
          }
        }
      }
    },
    "valueSystem": {
      "type": "object",
      "required": [
        "title",
        "W",
        "status"
      ],
      "properties": {
        "title": {
          "$ref": "common.schema.json#/$defs/line"
        },
        "W": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "status": {
          "enum": [
            "active",
            "dropped"
          ]
        },
        "registryUrl": {
          "type": "string",
          "pattern": "^https://"
        },
        "registrySystemId": {
          "type": "string",
          "maxLength": 60
        },
        "group": {
          "type": "string",
          "maxLength": 100
        },
        "note": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "vss": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "schemaId",
              "holderNodeId"
            ],
            "properties": {
              "schemaId": {
                "type": "string",
                "maxLength": 100
              },
              "title": {
                "$ref": "common.schema.json#/$defs/line"
              },
              "holderNodeId": {
                "type": "string",
                "maxLength": 100
              },
              "nodeContacts": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "common.schema.json#/$defs/uuid"
                }
              },
              "source": {
                "enum": [
                  "account",
                  "link",
                  "file"
                ]
              }
            }
          }
        }
      }
    },
    "goal": {
      "type": "object",
      "required": [
        "title",
        "S",
        "status"
      ],
      "properties": {
        "title": {
          "$ref": "common.schema.json#/$defs/line"
        },
        "systemId": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "S": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "N": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "type": "string",
          "maxLength": 40
        },
        "status": {
          "enum": [
            "active",
            "reached",
            "dropped"
          ]
        },
        "why": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "signs": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "horizon": {
          "type": "string",
          "maxLength": 100
        },
        "factIds": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/uuid"
          }
        }
      }
    },
    "event": {
      "type": "object",
      "required": [
        "actor",
        "action",
        "objects",
        "affected",
        "role",
        "occurredAt",
        "status"
      ],
      "properties": {
        "actor": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "action": {
          "$ref": "common.schema.json#/$defs/line"
        },
        "actionType": {
          "type": "string",
          "maxLength": 60
        },
        "objects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label"
            ],
            "properties": {
              "label": {
                "$ref": "common.schema.json#/$defs/line"
              },
              "typeId": {
                "$ref": "common.schema.json#/$defs/uuid"
              },
              "quantity": {
                "type": "number"
              },
              "unit": {
                "type": "string",
                "maxLength": 40
              },
              "note": {
                "$ref": "common.schema.json#/$defs/text"
              }
            }
          }
        },
        "affected": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/uuid"
          }
        },
        "role": {
          "enum": [
            "actor",
            "affected",
            "user",
            "witness"
          ]
        },
        "occurredAt": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/time"
            },
            {
              "$ref": "common.schema.json#/$defs/date"
            }
          ]
        },
        "approx": {
          "type": "boolean"
        },
        "systemId": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "registryRef": {
          "$ref": "common.schema.json#/$defs/registryRef"
        },
        "status": {
          "enum": [
            "confirmed",
            "suggested",
            "rejected"
          ]
        },
        "suggestedBy": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "receipt": {
          "$ref": "receipt.schema.json"
        },
        "receiptState": {
          "enum": [
            "offered",
            "matched",
            "disputed"
          ]
        },
        "receiptOpening": {
          "type": "object"
        },
        "stamps": {
          "type": "array",
          "items": {
            "$ref": "arbiter.schema.json#/$defs/stamp"
          }
        },
        "rulings": {
          "type": "array",
          "items": {
            "$ref": "arbiter.schema.json#/$defs/ruling"
          }
        },
        "vssRef": {
          "type": "object",
          "required": [
            "vssSchemaId",
            "flowId"
          ],
          "properties": {
            "vssSchemaId": {
              "type": "string",
              "maxLength": 100
            },
            "flowId": {
              "type": "string",
              "maxLength": 100
            },
            "flowLabel": {
              "$ref": "common.schema.json#/$defs/line"
            },
            "elementTypeId": {
              "type": "string",
              "maxLength": 100
            },
            "item": {
              "type": "object",
              "properties": {
                "boardId": {
                  "type": "string"
                },
                "itemId": {
                  "type": "string"
                },
                "title": {
                  "$ref": "common.schema.json#/$defs/line"
                }
              }
            }
          }
        },
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "caseId",
              "arbiterUrl",
              "request",
              "openedAt",
              "status"
            ],
            "properties": {
              "caseId": {
                "$ref": "common.schema.json#/$defs/uuid"
              },
              "arbiterUrl": {
                "type": "string",
                "format": "uri"
              },
              "request": {
                "enum": [
                  "attest",
                  "opinion",
                  "decision"
                ]
              },
              "openedAt": {
                "$ref": "common.schema.json#/$defs/time"
              },
              "status": {
                "enum": [
                  "open",
                  "decided",
                  "declined"
                ]
              },
              "problem": {
                "type": "string"
              },
              "reason": {
                "type": "string",
                "maxLength": 2000
              }
            }
          }
        },
        "streamRef": {
          "$ref": "stream.schema.json#/$defs/streamRef"
        }
      },
      "if": {
        "properties": {
          "status": {
            "const": "suggested"
          }
        }
      },
      "then": {
        "required": [
          "suggestedBy"
        ]
      }
    },
    "elementType": {
      "type": "object",
      "required": [
        "name",
        "category"
      ],
      "properties": {
        "name": {
          "$ref": "common.schema.json#/$defs/line"
        },
        "category": {
          "enum": [
            "thing",
            "service",
            "information",
            "time",
            "money",
            "right",
            "decision",
            "relation",
            "action",
            "other"
          ]
        }
      }
    },
    "plan": {
      "type": "object",
      "required": [
        "eventId",
        "author",
        "promise"
      ],
      "properties": {
        "eventId": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "objectIndex": {
          "type": "integer",
          "minimum": 0
        },
        "author": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "promise": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "plannedV": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "plannedSpentV": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "registryRef": {
          "$ref": "common.schema.json#/$defs/registryRef"
        }
      }
    },
    "assessment": {
      "type": "object",
      "required": [
        "eventId",
        "phase",
        "confidence",
        "reference"
      ],
      "properties": {
        "eventId": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "objectIndex": {
          "type": "integer",
          "minimum": 0
        },
        "phase": {
          "enum": [
            "realized",
            "retro"
          ]
        },
        "gained": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/line"
          }
        },
        "lost": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/line"
          }
        },
        "ownScore": {
          "type": "object",
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": "number"
            },
            "unit": {
              "type": "string",
              "maxLength": 40
            }
          }
        },
        "contributions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "goalId"
            ],
            "properties": {
              "goalId": {
                "$ref": "common.schema.json#/$defs/uuid"
              },
              "c": {
                "type": "number"
              },
              "k": {
                "type": "number"
              }
            },
            "anyOf": [
              {
                "required": [
                  "c"
                ]
              },
              {
                "required": [
                  "k"
                ]
              }
            ]
          }
        },
        "spent": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "goalId"
            ],
            "properties": {
              "goalId": {
                "$ref": "common.schema.json#/$defs/uuid"
              },
              "c": {
                "type": "number"
              },
              "k": {
                "type": "number"
              }
            },
            "anyOf": [
              {
                "required": [
                  "c"
                ]
              },
              {
                "required": [
                  "k"
                ]
              }
            ]
          }
        },
        "v": {
          "type": "number"
        },
        "spentV": {
          "type": "number",
          "minimum": 0
        },
        "planCount": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reference": {
          "type": "boolean"
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "reasons": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "checkAfter": {
          "$ref": "common.schema.json#/$defs/date"
        },
        "reaction": {
          "enum": [
            -100,
            -20,
            0,
            20,
            100,
            500
          ]
        },
        "comparison": {
          "type": "object",
          "required": [
            "referenceEventId",
            "polarity",
            "ratio"
          ],
          "properties": {
            "referenceEventId": {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            "referenceTitle": {
              "$ref": "common.schema.json#/$defs/line"
            },
            "polarity": {
              "enum": [
                "benefit",
                "harm"
              ]
            },
            "ratio": {
              "enum": [
                0.5,
                1,
                2,
                null
              ]
            },
            "refV": {
              "type": "number"
            },
            "estV": {
              "type": "number"
            },
            "at": {
              "$ref": "common.schema.json#/$defs/time"
            }
          }
        },
        "vet": {
          "type": "object",
          "required": [
            "snapshotHash"
          ],
          "properties": {
            "boardId": {
              "type": "string"
            },
            "resultId": {
              "type": "string"
            },
            "snapshotHash": {
              "$ref": "common.schema.json#/$defs/sha256"
            },
            "revision": {
              "type": "number"
            },
            "totals": {
              "type": "object"
            },
            "axes": {
              "type": "object"
            },
            "receivedAt": {
              "$ref": "common.schema.json#/$defs/time"
            },
            "boardSnapshot": {
              "type": "object"
            }
          }
        }
      }
    },
    "fact": {
      "type": "object",
      "required": [
        "text",
        "certainty"
      ],
      "properties": {
        "topic": {
          "type": "string",
          "maxLength": 100
        },
        "text": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "certainty": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "exploring": {
          "type": "boolean"
        },
        "goalIds": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/uuid"
          }
        }
      }
    },
    "settings": {
      "type": "object",
      "properties": {
        "planCountDefault": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0
        },
        "planCountBy": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "factor"
            ],
            "properties": {
              "contactId": {
                "$ref": "common.schema.json#/$defs/uuid"
              },
              "systemId": {
                "$ref": "common.schema.json#/$defs/uuid"
              },
              "factor": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "requests": {
          "type": "object",
          "properties": {
            "blockAll": {
              "type": "boolean"
            },
            "blockSystems": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/uuid"
              }
            },
            "blockContacts": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/uuid"
              }
            }
          }
        },
        "relays": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https://"
          }
        },
        "bridges": {
          "type": "object",
          "properties": {
            "vss": {
              "type": "object",
              "properties": {
                "share": {
                  "enum": [
                    "fact",
                    "value"
                  ],
                  "default": "fact"
                }
              }
            }
          }
        },
        "arbiters": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/arbiterRef"
          }
        },
        "providers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "device",
                  "file",
                  "aevri",
                  "github",
                  "webdav",
                  "s3",
                  "custom"
                ]
              },
              "id": {
                "type": "string",
                "maxLength": 60
              },
              "label": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "config": {
                "type": "object",
                "properties": {
                  "owner": {
                    "type": "string"
                  },
                  "repo": {
                    "type": "string"
                  },
                  "branch": {
                    "type": "string"
                  },
                  "token": {
                    "type": "string"
                  },
                  "apiBase": {
                    "type": "string"
                  }
                }
              },
              "recovery": {
                "type": "object",
                "properties": {
                  "slotId": {
                    "type": "string"
                  },
                  "keyId": {
                    "type": "string"
                  }
                }
              },
              "lastSync": {
                "$ref": "common.schema.json#/$defs/time"
              },
              "ageConfirmed": {
                "type": "boolean"
              }
            }
          }
        },
        "storage": {
          "$ref": "common.schema.json#/$defs/storagePolicy"
        }
      }
    },
    "messageIn": {
      "type": "object",
      "required": [
        "envelopeDigest",
        "verified",
        "receivedAt",
        "body",
        "state"
      ],
      "properties": {
        "envelopeDigest": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "from": {
          "$ref": "common.schema.json#/$defs/address"
        },
        "verified": {
          "type": "boolean"
        },
        "receivedAt": {
          "$ref": "common.schema.json#/$defs/time"
        },
        "body": {
          "$ref": "message.schema.json#/$defs/body"
        },
        "state": {
          "enum": [
            "new",
            "accepted",
            "ignored"
          ]
        }
      }
    },
    "messageOut": {
      "type": "object",
      "required": [
        "to",
        "kind",
        "sentAt",
        "envelopeDigest"
      ],
      "properties": {
        "to": {
          "$ref": "common.schema.json#/$defs/address"
        },
        "kind": {
          "enum": [
            "share",
            "request",
            "event-offer",
            "card",
            "suggestion",
            "subscribe",
            "subscribed",
            "unsubscribe",
            "unsubscribed",
            "stream-events",
            "replay"
          ]
        },
        "sentAt": {
          "$ref": "common.schema.json#/$defs/time"
        },
        "envelopeDigest": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "about": {
          "$ref": "common.schema.json#/$defs/uuid"
        }
      }
    },
    "grant": {
      "type": "object",
      "required": [
        "recordIds",
        "recipient",
        "fields",
        "purpose"
      ],
      "properties": {
        "recordIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/uuid"
          }
        },
        "recipient": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            {
              "enum": [
                "public-anon",
                "public-named"
              ]
            }
          ]
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "strip": {
          "type": "array",
          "items": {
            "enum": [
              "name",
              "age",
              "place",
              "free-text",
              "goals",
              "own-scale"
            ]
          }
        },
        "until": {
          "$ref": "common.schema.json#/$defs/date"
        },
        "purpose": {
          "enum": [
            "share",
            "bilateral",
            "research-contribution",
            "personal"
          ]
        }
      }
    },
    "revocation": {
      "type": "object",
      "required": [
        "grantId"
      ],
      "properties": {
        "grantId": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "reason": {
          "$ref": "common.schema.json#/$defs/line"
        }
      }
    },
    "disclosure": {
      "type": "object",
      "required": [
        "grantId",
        "deliveredAt",
        "recipient",
        "contentHash"
      ],
      "properties": {
        "grantId": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "deliveredAt": {
          "$ref": "common.schema.json#/$defs/time"
        },
        "recipient": {
          "type": "string"
        },
        "contentHash": {
          "$ref": "common.schema.json#/$defs/sha256"
        }
      }
    },
    "import": {
      "type": "object",
      "required": [
        "origin",
        "originId",
        "payload",
        "payloadHash"
      ],
      "properties": {
        "origin": {
          "enum": [
            "aevri.site",
            "aevri.vvp",
            "vet",
            "vss",
            "file",
            "url",
            "device",
            "agent"
          ]
        },
        "originId": {
          "type": "string"
        },
        "payload": {},
        "payloadHash": {
          "$ref": "common.schema.json#/$defs/sha256"
        }
      }
    },
    "note": {
      "type": "object",
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "$ref": "common.schema.json#/$defs/text"
        }
      }
    },
    "stream": {
      "type": "object",
      "required": [
        "providerAddress",
        "streamId",
        "descriptor",
        "addedAt"
      ],
      "properties": {
        "providerAddress": {
          "$ref": "common.schema.json#/$defs/address"
        },
        "streamId": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "descriptorUrl": {
          "type": "string",
          "pattern": "^https://"
        },
        "descriptor": {
          "$ref": "stream.schema.json"
        },
        "subscriptionId": {
          "type": "string",
          "maxLength": 100
        },
        "cursor": {
          "type": "string",
          "maxLength": 500
        },
        "selfRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100
          }
        },
        "contactMap": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "ref",
              "contactId"
            ],
            "properties": {
              "ref": {
                "type": "string",
                "maxLength": 100
              },
              "contactId": {
                "$ref": "common.schema.json#/$defs/uuid"
              }
            }
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "match"
            ],
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/uuid"
              },
              "match": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string"
                  },
                  "participantRef": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "actorRef": {
                    "type": "string",
                    "maxLength": 100
                  }
                }
              },
              "createdAt": {
                "$ref": "common.schema.json#/$defs/time"
              }
            }
          }
        },
        "handled": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "eventId",
              "rev",
              "state"
            ],
            "properties": {
              "eventId": {
                "type": "string",
                "maxLength": 100
              },
              "rev": {
                "type": "integer",
                "minimum": 1
              },
              "state": {
                "enum": [
                  "confirmed",
                  "rejected",
                  "withdrawn"
                ]
              }
            }
          }
        },
        "paused": {
          "type": "boolean"
        },
        "leaving": {
          "type": "boolean"
        },
        "addedAt": {
          "$ref": "common.schema.json#/$defs/time"
        }
      }
    }
  }
}
