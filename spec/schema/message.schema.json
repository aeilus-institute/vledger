{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aeilus.institute/schema/vledger/1/message.schema.json",
  "title": "aevri.vledger 1.0-d2 encrypted message between wallets",
  "type": "object",
  "required": [
    "type",
    "version",
    "id",
    "to",
    "sentAt",
    "epk",
    "iv",
    "ct"
  ],
  "properties": {
    "type": {
      "const": "aevri.vledger.message"
    },
    "version": {
      "const": 1
    },
    "id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "to": {
      "$ref": "common.schema.json#/$defs/address"
    },
    "from": {
      "$ref": "common.schema.json#/$defs/address"
    },
    "sentAt": {
      "$ref": "common.schema.json#/$defs/time"
    },
    "epk": {
      "$ref": "common.schema.json#/$defs/ecJwk"
    },
    "iv": {
      "$ref": "common.schema.json#/$defs/b64u",
      "minLength": 16,
      "maxLength": 16
    },
    "ct": {
      "$ref": "common.schema.json#/$defs/b64u"
    },
    "sig": {
      "$ref": "common.schema.json#/$defs/b64u"
    }
  },
  "dependentRequired": {
    "from": [
      "sig"
    ],
    "sig": [
      "from"
    ]
  },
  "$defs": {
    "body": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "event",
            "phase",
            "publish"
          ],
          "properties": {
            "kind": {
              "const": "share"
            },
            "event": {
              "type": "object",
              "required": [
                "actor",
                "action"
              ],
              "properties": {
                "actor": {
                  "$ref": "common.schema.json#/$defs/line"
                },
                "action": {
                  "$ref": "common.schema.json#/$defs/line"
                },
                "objects": {
                  "type": "array",
                  "items": {
                    "$ref": "common.schema.json#/$defs/line"
                  }
                },
                "affected": {
                  "type": "array",
                  "items": {
                    "$ref": "common.schema.json#/$defs/line"
                  }
                },
                "occurredAt": {
                  "oneOf": [
                    {
                      "$ref": "common.schema.json#/$defs/time"
                    },
                    {
                      "$ref": "common.schema.json#/$defs/date"
                    }
                  ]
                },
                "registryRef": {
                  "$ref": "common.schema.json#/$defs/registryRef"
                }
              }
            },
            "phase": {
              "enum": [
                "realized",
                "retro"
              ]
            },
            "gained": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/line"
              }
            },
            "lost": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/line"
              }
            },
            "v": {
              "type": "number"
            },
            "spentV": {
              "type": "number",
              "minimum": 0
            },
            "planGap": {
              "enum": [
                "above-plan",
                "as-planned",
                "below-plan",
                "harm",
                "unknown"
              ]
            },
            "publish": {
              "enum": [
                "no",
                "anonymous",
                "named"
              ]
            },
            "system": {
              "$ref": "common.schema.json#/$defs/line"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "event"
          ],
          "properties": {
            "kind": {
              "const": "request"
            },
            "event": {
              "type": "object",
              "required": [
                "actor",
                "action"
              ],
              "properties": {
                "actor": {
                  "$ref": "common.schema.json#/$defs/line"
                },
                "action": {
                  "$ref": "common.schema.json#/$defs/line"
                },
                "objects": {
                  "type": "array",
                  "items": {
                    "$ref": "common.schema.json#/$defs/line"
                  }
                },
                "affected": {
                  "type": "array",
                  "items": {
                    "$ref": "common.schema.json#/$defs/line"
                  }
                },
                "occurredAt": {
                  "oneOf": [
                    {
                      "$ref": "common.schema.json#/$defs/time"
                    },
                    {
                      "$ref": "common.schema.json#/$defs/date"
                    }
                  ]
                },
                "registryRef": {
                  "$ref": "common.schema.json#/$defs/registryRef"
                }
              }
            },
            "system": {
              "$ref": "common.schema.json#/$defs/line"
            },
            "systemRegistryUrl": {
              "type": "string",
              "pattern": "^https://"
            },
            "plan": {
              "type": "object",
              "properties": {
                "promise": {
                  "$ref": "common.schema.json#/$defs/text"
                },
                "plannedV": {
                  "type": "number",
                  "minimum": -1,
                  "maximum": 1
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "receipt"
          ],
          "properties": {
            "kind": {
              "const": "event-offer"
            },
            "receipt": {
              "$ref": "receipt.schema.json"
            },
            "opening": {
              "type": "object",
              "description": "What the digests hide, for the other party only",
              "properties": {
                "action": {
                  "type": "object",
                  "required": [
                    "salt",
                    "text"
                  ],
                  "properties": {
                    "salt": {
                      "$ref": "common.schema.json#/$defs/b64u"
                    },
                    "text": {
                      "$ref": "common.schema.json#/$defs/line"
                    }
                  }
                },
                "objects": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "salt",
                      "label"
                    ],
                    "properties": {
                      "salt": {
                        "$ref": "common.schema.json#/$defs/b64u"
                      },
                      "label": {
                        "$ref": "common.schema.json#/$defs/line"
                      },
                      "quantity": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "unit": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "note": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    }
                  }
                },
                "roles": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "actor",
                      "affected",
                      "user",
                      "witness",
                      "party"
                    ]
                  }
                },
                "occurredAt": {
                  "oneOf": [
                    {
                      "$ref": "common.schema.json#/$defs/time"
                    },
                    {
                      "$ref": "common.schema.json#/$defs/date"
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "card"
          ],
          "properties": {
            "kind": {
              "const": "card"
            },
            "card": {
              "$ref": "card.schema.json"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "events"
          ],
          "properties": {
            "kind": {
              "const": "suggestion"
            },
            "source": {
              "$ref": "common.schema.json#/$defs/line"
            },
            "events": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "actor",
                  "action"
                ],
                "properties": {
                  "actor": {
                    "$ref": "common.schema.json#/$defs/line"
                  },
                  "action": {
                    "$ref": "common.schema.json#/$defs/line"
                  },
                  "objects": {
                    "type": "array",
                    "items": {
                      "$ref": "common.schema.json#/$defs/line"
                    }
                  },
                  "affected": {
                    "type": "array",
                    "items": {
                      "$ref": "common.schema.json#/$defs/line"
                    }
                  },
                  "occurredAt": {
                    "oneOf": [
                      {
                        "$ref": "common.schema.json#/$defs/time"
                      },
                      {
                        "$ref": "common.schema.json#/$defs/date"
                      }
                    ]
                  },
                  "registryRef": {
                    "$ref": "common.schema.json#/$defs/registryRef"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "streamId",
            "code",
            "subscriber",
            "proof"
          ],
          "properties": {
            "kind": {
              "const": "subscribe"
            },
            "streamId": {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            "code": {
              "type": "string",
              "minLength": 22,
              "maxLength": 100
            },
            "subscriber": {
              "$ref": "stream.schema.json#/$defs/subscriber"
            },
            "proof": {
              "$ref": "common.schema.json#/$defs/b64u"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "streamId",
            "subscriptionId"
          ],
          "properties": {
            "kind": {
              "const": "subscribed"
            },
            "streamId": {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            "subscriptionId": {
              "type": "string",
              "maxLength": 100
            },
            "descriptor": {
              "$ref": "stream.schema.json"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "streamId",
            "subscriptionId"
          ],
          "properties": {
            "kind": {
              "const": "unsubscribe"
            },
            "streamId": {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            "subscriptionId": {
              "type": "string",
              "maxLength": 100
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "streamId",
            "subscriptionId",
            "deleted",
            "sig"
          ],
          "properties": {
            "kind": {
              "const": "unsubscribed"
            },
            "streamId": {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            "subscriptionId": {
              "type": "string",
              "maxLength": 100
            },
            "deleted": {
              "type": "boolean"
            },
            "at": {
              "$ref": "common.schema.json#/$defs/time"
            },
            "sig": {
              "$ref": "common.schema.json#/$defs/b64u"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "events"
          ],
          "properties": {
            "kind": {
              "const": "stream-events"
            },
            "events": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": {
                "$ref": "stream.schema.json#/$defs/streamEvent"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "streamId"
          ],
          "properties": {
            "kind": {
              "const": "replay"
            },
            "streamId": {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            "since": {
              "$ref": "common.schema.json#/$defs/time"
            }
          }
        },
        {
          "$ref": "stream.schema.json#/$defs/feedback"
        },
        {
          "$ref": "stream.schema.json#/$defs/feedbackReceipt"
        },
        {
          "type": "object",
          "required": [
            "kind",
            "providerAddress",
            "streamId",
            "feedbackId",
            "requestId",
            "sig"
          ],
          "properties": {
            "kind": {
              "const": "feedback-status"
            },
            "providerAddress": {
              "$ref": "common.schema.json#/$defs/address"
            },
            "streamId": {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            "feedbackId": {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            "requestId": {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            "sig": {
              "$ref": "common.schema.json#/$defs/b64u"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "providerAddress",
            "streamId",
            "feedbackId",
            "requestId",
            "sig"
          ],
          "properties": {
            "kind": {
              "const": "feedback-withdraw"
            },
            "providerAddress": {
              "$ref": "common.schema.json#/$defs/address"
            },
            "streamId": {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            "feedbackId": {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            "requestId": {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            "sig": {
              "$ref": "common.schema.json#/$defs/b64u"
            }
          }
        }
      ]
    }
  }
}
