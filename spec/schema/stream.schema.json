{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aeilus.institute/schema/vledger/1/stream.schema.json",
  "title": "aevri.vledger 1.0-d9 event streams (SPEC 20)",
  "type": "object",
  "required": [
    "stream",
    "sig"
  ],
  "properties": {
    "stream": {
      "type": "object",
      "required": [
        "type",
        "version",
        "descriptorRev",
        "streamId",
        "title",
        "provider",
        "access",
        "transport",
        "identifies",
        "policy",
        "updatedAt"
      ],
      "properties": {
        "type": {
          "const": "aevri.vledger.stream"
        },
        "version": {
          "const": 1
        },
        "descriptorRev": {
          "type": "integer",
          "minimum": 1
        },
        "streamId": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "title": {
          "$ref": "common.schema.json#/$defs/line"
        },
        "provider": {
          "type": "object",
          "required": [
            "name",
            "address",
            "encKey"
          ],
          "properties": {
            "name": {
              "$ref": "common.schema.json#/$defs/line"
            },
            "kind": {
              "enum": [
                "person",
                "organization",
                "state",
                "group",
                "device",
                "agent"
              ]
            },
            "address": {
              "$ref": "common.schema.json#/$defs/address"
            },
            "encKey": {
              "$ref": "common.schema.json#/$defs/ecJwk"
            }
          }
        },
        "access": {
          "enum": [
            "open",
            "code"
          ]
        },
        "transport": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "https",
              "relay"
            ]
          }
        },
        "endpoint": {
          "type": "string",
          "pattern": "^https://"
        },
        "relay": {
          "type": "string",
          "pattern": "^https://"
        },
        "identifies": {
          "enum": [
            "provider",
            "holder"
          ]
        },
        "eventKinds": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 40
          }
        },
        "policy": {
          "type": "object",
          "required": [
            "keeps",
            "deletesOnLeave",
            "rawStays"
          ],
          "properties": {
            "keeps": {
              "$ref": "common.schema.json#/$defs/text"
            },
            "retentionDays": {
              "type": "integer",
              "minimum": 0
            },
            "deletesOnLeave": {
              "type": "boolean"
            },
            "rawStays": {
              "type": "boolean"
            },
            "url": {
              "type": "string",
              "pattern": "^https://"
            }
          }
        },
        "updatedAt": {
          "$ref": "common.schema.json#/$defs/time"
        },
        "audience": {
          "enum": [
            "participants",
            "selected-readers",
            "public"
          ]
        },
        "feedback": {
          "type": "object",
          "required": [
            "accepts",
            "senders",
            "moderation",
            "publishes"
          ],
          "properties": {
            "accepts": {
              "type": "array",
              "minItems": 1,
              "items": {
                "enum": [
                  "assessment",
                  "participation",
                  "event"
                ]
              }
            },
            "senders": {
              "type": "array",
              "minItems": 1,
              "items": {
                "enum": [
                  "anonymous",
                  "subscriber",
                  "named"
                ]
              }
            },
            "moderation": {
              "enum": [
                "none",
                "before",
                "after"
              ]
            },
            "publishes": {
              "enum": [
                "no",
                "anonymous",
                "named",
                "sender-choice"
              ]
            },
            "retentionDays": {
              "type": "integer",
              "minimum": 0
            },
            "rulesUrl": {
              "type": "string",
              "pattern": "^https://"
            }
          }
        },
        "owner": {
          "type": "object",
          "required": [
            "card",
            "proof"
          ],
          "properties": {
            "card": {
              "$ref": "card.schema.json"
            },
            "proof": {
              "$ref": "common.schema.json#/$defs/b64u"
            }
          },
          "description": "Named personal stream: identity key over {purpose, streamId, streamAddress}"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "transport": {
                "contains": {
                  "const": "https"
                }
              }
            }
          },
          "then": {
            "required": [
              "endpoint"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "access": {
                "const": "open"
              }
            }
          },
          "then": {
            "properties": {
              "identifies": {
                "const": "holder"
              }
            }
          }
        }
      ]
    },
    "sig": {
      "$ref": "common.schema.json#/$defs/b64u"
    }
  },
  "$defs": {
    "streamEvent": {
      "type": "object",
      "required": [
        "type",
        "version",
        "streamId",
        "eventId",
        "rev",
        "occurredAt",
        "actor",
        "action",
        "sig"
      ],
      "properties": {
        "type": {
          "const": "aevri.vledger.stream-event"
        },
        "version": {
          "const": 1
        },
        "streamId": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "eventId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,100}$"
        },
        "rev": {
          "type": "integer",
          "minimum": 1
        },
        "recipient": {
          "$ref": "common.schema.json#/$defs/address"
        },
        "occurredAt": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/time"
            },
            {
              "$ref": "common.schema.json#/$defs/date"
            }
          ]
        },
        "approx": {
          "type": "boolean"
        },
        "until": {
          "$ref": "common.schema.json#/$defs/time"
        },
        "kind": {
          "type": "string",
          "maxLength": 40
        },
        "actor": {
          "type": "object",
          "required": [
            "label"
          ],
          "properties": {
            "ref": {
              "type": "string",
              "maxLength": 100
            },
            "label": {
              "$ref": "common.schema.json#/$defs/line"
            }
          }
        },
        "action": {
          "$ref": "common.schema.json#/$defs/line"
        },
        "objects": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": [
              "label"
            ],
            "properties": {
              "label": {
                "$ref": "common.schema.json#/$defs/line"
              },
              "type": {
                "type": "string",
                "maxLength": 40
              },
              "quantity": {
                "type": "number"
              },
              "unit": {
                "type": "string",
                "maxLength": 40
              }
            }
          }
        },
        "participants": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": [
              "ref",
              "label"
            ],
            "properties": {
              "ref": {
                "type": "string",
                "maxLength": 100
              },
              "label": {
                "$ref": "common.schema.json#/$defs/line"
              },
              "role": {
                "enum": [
                  "actor",
                  "affected",
                  "user",
                  "witness"
                ]
              },
              "you": {
                "const": true
              }
            }
          }
        },
        "summary": {
          "type": "string",
          "maxLength": 1000
        },
        "source": {
          "type": "object",
          "properties": {
            "label": {
              "$ref": "common.schema.json#/$defs/line"
            },
            "url": {
              "type": "string",
              "pattern": "^https://"
            }
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "withdrawn": {
          "type": "boolean"
        },
        "sig": {
          "$ref": "common.schema.json#/$defs/b64u"
        },
        "assessment": {
          "type": "object",
          "properties": {
            "phase": {
              "enum": [
                "realized",
                "retro"
              ]
            },
            "reaction": {
              "enum": [
                -100,
                -20,
                0,
                20,
                100,
                500
              ]
            },
            "gained": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/line"
              }
            },
            "lost": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/line"
              }
            },
            "words": {
              "type": "string",
              "maxLength": 2000
            },
            "planGap": {
              "enum": [
                "above-plan",
                "as-planned",
                "below-plan",
                "harm",
                "unknown"
              ]
            },
            "v": {
              "type": "number"
            },
            "spentV": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "streamRef": {
      "type": "object",
      "required": [
        "provider",
        "streamId",
        "eventId",
        "rev"
      ],
      "properties": {
        "provider": {
          "$ref": "common.schema.json#/$defs/address"
        },
        "streamId": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "eventId": {
          "type": "string",
          "maxLength": 100
        },
        "rev": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "participant": {
      "type": "object",
      "required": [
        "ref",
        "label"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "maxLength": 100
        },
        "label": {
          "$ref": "common.schema.json#/$defs/line"
        },
        "role": {
          "enum": [
            "actor",
            "affected",
            "user",
            "witness"
          ]
        },
        "you": {
          "const": true
        }
      }
    },
    "subscriber": {
      "type": "object",
      "required": [
        "address",
        "encKey"
      ],
      "properties": {
        "address": {
          "$ref": "common.schema.json#/$defs/address"
        },
        "encKey": {
          "$ref": "common.schema.json#/$defs/ecJwk"
        }
      }
    },
    "feedback": {
      "type": "object",
      "required": [
        "kind",
        "version",
        "feedbackId",
        "providerAddress",
        "streamId",
        "type",
        "publish",
        "sender",
        "key",
        "replyEncKey",
        "sentAt",
        "sig"
      ],
      "properties": {
        "kind": {
          "const": "stream-feedback"
        },
        "version": {
          "const": 1
        },
        "feedbackId": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "providerAddress": {
          "$ref": "common.schema.json#/$defs/address"
        },
        "streamId": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "descriptorRev": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "enum": [
            "assessment",
            "participation",
            "event"
          ]
        },
        "about": {
          "type": "object",
          "required": [
            "eventId"
          ],
          "properties": {
            "eventId": {
              "type": "string",
              "maxLength": 100
            },
            "rev": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "event": {
          "type": "object",
          "required": [
            "action"
          ],
          "properties": {
            "action": {
              "$ref": "common.schema.json#/$defs/line"
            },
            "objects": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "object",
                "required": [
                  "label"
                ],
                "properties": {
                  "label": {
                    "$ref": "common.schema.json#/$defs/line"
                  }
                }
              }
            },
            "occurredAt": {
              "oneOf": [
                {
                  "$ref": "common.schema.json#/$defs/time"
                },
                {
                  "$ref": "common.schema.json#/$defs/date"
                }
              ]
            },
            "place": {
              "$ref": "common.schema.json#/$defs/line"
            }
          }
        },
        "role": {
          "enum": [
            "actor",
            "affected",
            "user",
            "witness"
          ]
        },
        "assessment": {
          "type": "object",
          "properties": {
            "phase": {
              "enum": [
                "realized",
                "retro"
              ]
            },
            "reaction": {
              "enum": [
                -100,
                -20,
                0,
                20,
                100,
                500
              ]
            },
            "gained": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/line"
              }
            },
            "lost": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/line"
              }
            },
            "words": {
              "type": "string",
              "maxLength": 2000
            },
            "planGap": {
              "enum": [
                "above-plan",
                "as-planned",
                "below-plan",
                "harm",
                "unknown"
              ]
            },
            "v": {
              "type": "number"
            },
            "spentV": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "publish": {
          "enum": [
            "no",
            "anonymous",
            "named"
          ]
        },
        "sender": {
          "enum": [
            "anonymous",
            "subscriber",
            "named"
          ]
        },
        "card": {
          "$ref": "card.schema.json"
        },
        "key": {
          "$ref": "common.schema.json#/$defs/address"
        },
        "replyEncKey": {
          "$ref": "common.schema.json#/$defs/ecJwk"
        },
        "sentAt": {
          "$ref": "common.schema.json#/$defs/time"
        },
        "sig": {
          "$ref": "common.schema.json#/$defs/b64u"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "assessment",
                  "participation"
                ]
              }
            }
          },
          "then": {
            "required": [
              "about"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "event"
              }
            }
          },
          "then": {
            "required": [
              "event"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "assessment"
              }
            }
          },
          "then": {
            "required": [
              "assessment"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "sender": {
                "const": "named"
              }
            }
          },
          "then": {
            "required": [
              "card"
            ]
          },
          "else": {
            "not": {
              "required": [
                "card"
              ]
            }
          }
        }
      ]
    },
    "feedbackReceipt": {
      "type": "object",
      "required": [
        "kind",
        "providerAddress",
        "streamId",
        "feedbackId",
        "itemHash",
        "statusRev",
        "status",
        "sig"
      ],
      "properties": {
        "kind": {
          "const": "feedback-receipt"
        },
        "providerAddress": {
          "$ref": "common.schema.json#/$defs/address"
        },
        "streamId": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "feedbackId": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "itemHash": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "statusRev": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "received",
            "pending",
            "published",
            "rejected",
            "withdrawn"
          ]
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "reason": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "sig": {
          "$ref": "common.schema.json#/$defs/b64u"
        }
      }
    },
    "feedbackAssessment": {
      "type": "object",
      "properties": {
        "phase": {
          "enum": [
            "realized",
            "retro"
          ]
        },
        "reaction": {
          "enum": [
            -100,
            -20,
            0,
            20,
            100,
            500
          ]
        },
        "gained": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/line"
          }
        },
        "lost": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/line"
          }
        },
        "words": {
          "type": "string",
          "maxLength": 2000
        },
        "planGap": {
          "enum": [
            "above-plan",
            "as-planned",
            "below-plan",
            "harm",
            "unknown"
          ]
        },
        "v": {
          "type": "number"
        },
        "spentV": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
